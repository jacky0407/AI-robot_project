# backend/.env.example
# 複製此檔案為 .env 並填入真實的值
# 絕對不要把 .env 加入 Git！

# Supabase（由成員二提供）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Gemini API（向 Google AI Studio 申請）
GEMINI_API_KEY=AIzaSy...

# 環境設定
ENVIRONMENT=development   # development | production

# 前端網址（開發時）
FRONTEND_URL=http://localhost:3000
