# backend/.env.example
# 複製此檔案為 .env 並填入真實的值
# 絕對不要把 .env 加入 Git！

# Supabase（由成員二提供）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Gemini API（向 Google AI Studio 申請）
GEMINI_API_KEY=AIzaSy...
# 所有 AI 功能共用的模型；不填就用 gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# 環境設定
ENVIRONMENT=development   # development | production

# 允許呼叫後端的前端網址（CORS），多個用逗號分隔
# 雲端例：FRONTEND_URL=https://xxx.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# 單次 Gemini 呼叫的逾時秒數（不填就是 90）
LLM_TIMEOUT_SECONDS=90

# 學生自備 Gemini 金鑰的加密金鑰（不填就不開放自備金鑰）。產生方式：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 換掉會讓已存的學生金鑰全部失效
API_KEY_ENCRYPTION_KEY=
