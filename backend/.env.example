# backend/.env.example
# 複製此檔案為 .env 並填入真實的值
# 絕對不要把 .env 加入 Git！

# Supabase（由成員二提供）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Gemini API（向 Google AI Studio 申請）
GEMINI_API_KEY=AIzaSy...
# 所有 AI 功能共用的模型；不填就用 gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash
# 不打分數的對話功能（聊天室調度員、聊天回覆、學習助教、不評分機器人的回饋）改用較便宜的模型（選填）；
# 不填就跟 GEMINI_MODEL 一樣。評分、錯誤偵測、提示、跨步驟檢核一律用 GEMINI_MODEL
# GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
# 學習助教不直接給答案；同一個問題問到第幾次才直接給答案（選填，預設 3）
# TUTOR_ANSWER_AFTER=3
# AI 費用估算的價目表（美元／每百萬 token，JSON；選填，預設見 core/config.py）
# MODEL_PRICES={"gemini-3.5-flash": {"input": 1.5, "output": 9.0}}
# 自主探索每月平台費用上限（美元；選填，不填 = 不限）
# AUTONOMOUS_MONTHLY_BUDGET_USD=20
# 學習助教（RAG）切段與搜尋用的向量模型（選填，預設 gemini-embedding-001；維度固定 768）
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 環境設定
ENVIRONMENT=development   # development | production

# 允許呼叫後端的前端網址（CORS），多個用逗號分隔
# 雲端例：FRONTEND_URL=https://xxx.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# 單次 Gemini 呼叫的逾時秒數（不填就是 90）
LLM_TIMEOUT_SECONDS=90

# 學生自備 Gemini 金鑰的加密金鑰（不填就不開放自備金鑰）。產生方式：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 換掉會讓已存的學生金鑰全部失效
API_KEY_ENCRYPTION_KEY=
