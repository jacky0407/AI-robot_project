# 複製成 .env.local 後填入（.env.local 不會進 git）

# Supabase：Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# 後端 FastAPI 網址（本機開發預設 http://127.0.0.1:8000，結尾不要加 /）
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# 和 XR 系統聯調（不跑 XR 就留空，見 docs/SETUP.md「和 XR 系統聯調」）
# XR 前端的網址（例如 vite preview 的 http://localhost:4173），/xr 會轉到這裡
XR_FRONTEND_URL=
# XR 後端的網址，/xr-api 會轉到這裡
XR_BACKEND_URL=
